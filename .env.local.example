# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Your Sleeper league ID (from the league URL: sleeper.com/leagues/<LEAGUE_ID>/...)
SLEEPER_LEAGUE_ID=

# Your Sleeper user ID within that league (not your username — look it up once via
# https://api.sleeper.app/v1/league/<LEAGUE_ID>/users and match your display name).
SLEEPER_USER_ID=

# Shared passcode that gates access to the whole app. Leave blank in local dev
# to skip the login screen; set it before deploying anywhere public.
ACCESS_PASSCODE=
